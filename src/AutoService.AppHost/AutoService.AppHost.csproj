<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>autoservice-kozlov-apphost</UserSecretsId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.MySql" Version="13.6.5" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <ProjectReference Include="../AutoService.Api/AutoService.Api.csproj" />
    <ProjectReference Include="../AutoService.Migrations/AutoService.Migrations.csproj" />
  </ItemGroup>
</Project>
